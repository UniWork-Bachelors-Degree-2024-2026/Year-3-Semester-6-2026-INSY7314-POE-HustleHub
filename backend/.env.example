# Copy this file to .env and fill in real values. The .env file is ignored by Git.

# MongoDB connection string
CONN_STRING=

# Long random string used to sign login tokens
JWT_SECRET=

# Local CA certificate so Node trusts the development HTTPS certificate
NODE_EXTRA_CA_CERTS=

# Only used by "npm run seed:admin" to create the first admin account
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email delivery through Brevo (https://www.brevo.com). Use "console" only for local tests.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=HustleHub+

# Optional separate secret for hashing one time passcodes, falls back to JWT_SECRET
OTP_SECRET=

# Origins allowed to call the API (comma separated). Defaults to https://localhost:5173 when empty.
# Inside Docker Compose this is passed in from the compose file.
ALLOWED_ORIGINS=https://localhost:5173

# Optional account lockout overrides (failed logins before the lock, and minutes locked)
LOCKOUT_MAX_ATTEMPTS=
LOCKOUT_MINUTES=

# Optional rate limit overrides (requests per 15 minutes per IP)
AUTH_RATE_LIMIT_MAX=
API_RATE_LIMIT_MAX=
BOOKING_RATE_LIMIT_MAX=
OTP_RATE_LIMIT_MAX=

# Cloud Logging Platform: Better Stack
# Get your source token from https://betterstack.com
BETTERSTACK_SOURCE_TOKEN=your_betterstack_source_token_here
# Optional ingesting host shown in your Better Stack HTTP source (e.g. s12345.eu-nbg-2.betterstackdata.com or in.logs.betterstack.com)
BETTERSTACK_INGESTING_HOST=
